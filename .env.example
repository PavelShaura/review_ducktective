APP_ENV=dev
APP_LOG_LEVEL=INFO

# Порты смещены относительно стандартных: 5432 и 6379 заняты локальными
# Postgres и Redis. Меняются через POSTGRES_HOST_PORT / REDIS_HOST_PORT.
DATABASE_URL=postgresql+asyncpg://ducktective:ducktective@localhost:5433/ducktective
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=5

REDIS_URL=redis://localhost:6380/0

POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Профиль развёртывания: dev | airgapped | full
# В airgapped любые облачные провайдеры запрещены независимо от политики репозитория
DEPLOYMENT_PROFILE=dev

# Локальный инференс
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b
LOCAL_RERANKER_MODEL=bge-reranker-v2-m3
LOCAL_REVIEW_MODEL=qwen2.5-coder:14b

# Облачные провайдеры — используются только для репозиториев с egress_policy=allow_cloud
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Наблюдаемость
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Где хранятся рабочие копии репозиториев
REPOSITORIES_ROOT=./repos
