APP_ENV=dev
APP_LOG_LEVEL=INFO

# Порты смещены относительно стандартных: 5432 и 6379 заняты локальными
# Postgres и Redis. Меняются через POSTGRES_HOST_PORT / REDIS_HOST_PORT.
# Приложение ходит в базу ролью без прав суперпользователя: суперпользователь
# обходит row level security независимо от политик, и под ним изоляция тенантов
# существует только на бумаге. Роль заводит init-скрипт compose.
DATABASE_URL=postgresql+asyncpg://ducktective_app:ducktective_app@localhost:5433/ducktective
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=5

REDIS_URL=redis://localhost:6380/0

POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
KEYCLOAK_HOST_PORT=8081

# Провайдер личности. Без адреса realm api не стартует: сетевая служба
# без входа отдала бы данные любой организации всякому, кто угадает
# идентификатор. Realm поднимается из deploy/compose/keycloak.
OIDC_ISSUER=http://localhost:8081/realms/ducktective
OIDC_AUDIENCE=ducktective-api
OIDC_CLIENT_ID=ducktective-web
OIDC_DEVICE_CLIENT_ID=ducktective-cli
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Профиль развёртывания: dev | airgapped | full
# В airgapped любые облачные провайдеры запрещены независимо от политики репозитория
DEPLOYMENT_PROFILE=dev

# Локальный инференс.
# Вариант 1 — Ollama на этой же машине:
#   LOCAL_LLM_PROVIDER=ollama
#   LOCAL_LLM_BASE_URL=http://localhost:11434
#   LOCAL_REVIEW_MODEL=qwen2.5-coder:14b
# Вариант 2 — LM Studio на другом хосте (OpenAI-совместимый API, нужен суффикс /v1):
#   LOCAL_LLM_PROVIDER=lm_studio
#   LOCAL_LLM_BASE_URL=http://<host-с-gpu>:1234/v1
#   LOCAL_REVIEW_MODEL=google/gemma-4-e4b
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_API_KEY=
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Адрес сервиса эмбеддингов, если он отличается от LOCAL_LLM_BASE_URL
LOCAL_EMBEDDING_BASE_URL=
# Размерность вектора. Менять только вместе с миграцией: колонка pgvector фиксирована
EMBEDDING_DIMENSIONS=768
# Сколько токенов кодовой базы класть в подсказку ревьюеру. Считается вместе
# с патчем и ответом, поэтому упирается в контекстное окно модели
CONTEXT_TOKEN_BUDGET=2000
LOCAL_REVIEW_MODEL=qwen2.5-coder:14b
# Умеет ли локальная модель вызывать инструменты. От этого зависит агентный
# режим ревью: без вызовов он вырождается в одноразовый проход по диффу.
# Признак задаётся здесь, потому что серверы отвечают на неподдерживаемое поле
# по-разному — от молчаливого игнорирования до ошибки
LOCAL_REVIEW_MODEL_SUPPORTS_TOOLS=true
# Окно, с которым локальная модель загружена на сервере, 0 — неизвестно.
# Называет его сервер, а не модель: у LM Studio max_context_length и
# loaded_context_length расходятся на порядок, работает второе (/api/v0/models).
# Меньше 16384 агентному режиму мало: диалог копит каждый показанный фрагмент,
# и при разрешённом облаке такой узел уходит туда
LOCAL_REVIEW_MODEL_CONTEXT_WINDOW=16384
# Модель разговора, если она должна отличаться от модели ревью. Пусто — та же.
# Пример: LOCAL_CHAT_MODEL=google/gemma-4-12b
LOCAL_CHAT_MODEL=
# Сколько токенов ответа запрашивается у модели. Место под ответ резервируется
# в её окне: системный промпт (~1300) + CONTEXT_TOKEN_BUDGET + это число
# вычитаются из окна, остаток — всё, что осталось на сам дифф. При окне 8192
# запрошенные 4096 не оставляют места под файл крупнее сорока строк.
# У reasoning-моделей большая часть ответа уходит на размышления, и снижать
# число нельзя — там поднимают окно
LLM_MAX_OUTPUT_TOKENS=4096

# Сколько новая попытка ждёт, пока прежняя отпустит прогон. Прежняя узнаёт
# об отмене перед очередным обращением к модели, то есть с задержкой до одного
# вызова: четыре минуты покрывают LLM_TIMEOUT_SECONDS=180 с запасом
REVIEW_LOCK_WAIT_SECONDS=240

# Облачные провайдеры — используются только для репозиториев с egress_policy=allow_cloud
# Удалённые модели описываются реестром: имя, адрес, окно, умения и уровень
# доверия. Скопируйте remote_models.example.json в remote_models.json и оставьте
# те строки, ключи которых у вас есть. Уровень доверия — не украшение:
# `private_remote` означает провайдера с обязательством не учиться на запросах,
# `training_remote` — бесплатный тир, который такого обещания не даёт. Политика
# репозитория выбирает, до какого уровня коду разрешено уезжать.
# Секрет шифрования ключей провайдеров, заводимых организацией из интерфейса.
# Печатается командой `ducktective secret`. Без него модели с ключом сохранить
# нельзя: ключ лёг бы в базу открытым текстом.
MODELS_SECRET_KEY=

REMOTE_MODELS_FILE=remote_models.json

# Ключи моделей из реестра: имена переменных названы в нём полем api_key_env
ANTHROPIC_API_KEY=
# Окно облачной модели: по нему роутер решает, есть ли куда уйти узлу,
# которому не хватает локального
CLOUD_REVIEW_MODEL_CONTEXT_WINDOW=200000
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Наблюдаемость
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Где хранятся рабочие копии репозиториев
REPOSITORIES_ROOT=./repos

# MCP-сервер. Организация берётся из входа запустившего (`ducktective login`):
# у stdio-транспорта нет идентичности вызывающего, и сервер работает от того,
# кто его поднял
# Адрес и порт нужны только транспорту http, при stdio не используются
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8090
