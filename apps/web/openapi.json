{"openapi": "3.1.0", "info": {"title": "review_ducktective", "description": "Автоматическое code review на LLM с RAG по кодовой базе", "version": "0.1.0"}, "paths": {"/": {"get": {"tags": ["service"], "summary": "Describe Service", "description": "Корень сервиса: куда идти дальше, если открыл адрес руками.", "operationId": "describe_service__get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceResponse"}}}}}}}, "/health": {"get": {"tags": ["service"], "summary": "Check Health", "operationId": "check_health_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}}, "/repositories": {"post": {"tags": ["repositories"], "summary": "Register Repository", "operationId": "register_repository_repositories_post", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterRepositoryRequest"}}}}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RepositoryResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"tags": ["repositories"], "summary": "List Repositories", "operationId": "list_repositories_repositories_get", "parameters": [{"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RepositoryResponse"}, "title": "Response List Repositories Repositories Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/repositories/{repository_id}": {"delete": {"tags": ["repositories"], "summary": "Delete Repository", "description": "Убирает репозиторий вместе с индексом и делами.", "operationId": "delete_repository_repositories__repository_id__delete", "parameters": [{"name": "repository_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Repository Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/repositories/{repository_id}/index/cancel": {"post": {"tags": ["repositories"], "summary": "Cancel Indexing", "description": "Просит прекратить идущую индексацию.\n\nОтвет приходит сразу, а воркер выходит на ближайшей отсечке: обрывать\nего посреди записи нельзя, зато записанное откатывается транзакцией.", "operationId": "cancel_indexing_repositories__repository_id__index_cancel_post", "parameters": [{"name": "repository_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Repository Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CancelIndexingResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/repositories/{repository_id}/index": {"get": {"tags": ["repositories"], "summary": "Get Index State", "operationId": "get_index_state_repositories__repository_id__index_get", "parameters": [{"name": "repository_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Repository Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IndexStateResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "post": {"tags": ["repositories"], "summary": "Start Indexing", "description": "Ставит индексацию в очередь.\n\nЗапрос не ждёт результата: полная индексация чужого репозитория занимает\nминуты, а состояние потом опрашивается через GET.", "operationId": "start_indexing_repositories__repository_id__index_post", "parameters": [{"name": "repository_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Repository Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StartIndexingRequest"}}}}, "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StartIndexingResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/repositories/{repository_id}/reviews": {"post": {"tags": ["reviews"], "summary": "Start Review", "operationId": "start_review_repositories__repository_id__reviews_post", "parameters": [{"name": "repository_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Repository Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StartReviewRequest"}}}}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewRunResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"tags": ["reviews"], "summary": "List Reviews", "operationId": "list_reviews_repositories__repository_id__reviews_get", "parameters": [{"name": "repository_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Repository Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 50, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/ReviewRunSummary"}, "title": "Response List Reviews Repositories  Repository Id  Reviews Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reviews/{run_id}": {"get": {"tags": ["reviews"], "summary": "Get Review", "operationId": "get_review_reviews__run_id__get", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewRunResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "delete": {"tags": ["reviews"], "summary": "Delete Review", "operationId": "delete_review_reviews__run_id__delete", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reviews/{run_id}/run": {"post": {"tags": ["reviews"], "summary": "Enqueue Review", "description": "Ставит прогон в очередь.\n\nРевью занимает минуты, поэтому HTTP-запрос не ждёт его завершения: клиент\nопрашивает статус через GET.", "operationId": "enqueue_review_reviews__run_id__run_post", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewRunResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reviews/{run_id}/restart": {"post": {"tags": ["reviews"], "summary": "Restart Review", "description": "Отправляет прекращённый или неудавшийся прогон на расследование заново.\n\nФайлы диффа уже разобраны и остаются на месте — повторяется только чтение\nмоделью. Продолжения с места нет: находки пишутся все сразу в конце,\nи половины прогона в базе не существует.", "operationId": "restart_review_reviews__run_id__restart_post", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"202": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewRunResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reviews/{run_id}/cancel": {"post": {"tags": ["reviews"], "summary": "Cancel Review", "description": "Просит прекратить идущее расследование.\n\nОтвет приходит сразу, а воркер выходит перед следующим файлом: файл,\nкоторый модель читает прямо сейчас, дочитывается, но результат прогона\nне сохраняется.", "operationId": "cancel_review_reviews__run_id__cancel_post", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CancelRunResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reviews/{run_id}/findings/{finding_id}/feedback": {"post": {"tags": ["reviews"], "summary": "Submit Feedback", "description": "Фиксирует оценку находки.\n\nОтметки накапливаются как размеченная выборка для измерения качества.", "operationId": "submit_feedback_reviews__run_id__findings__finding_id__feedback_post", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "finding_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Finding Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitFeedbackRequest"}}}}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FeedbackResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reviews/{run_id}/files/{file_id}/patch": {"get": {"tags": ["reviews"], "summary": "Get File Patch", "operationId": "get_file_patch_reviews__run_id__files__file_id__patch_get", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "file_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "File Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FilePatchResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/reviews/{run_id}/files/{file_id}/content": {"get": {"tags": ["reviews"], "summary": "Get File Context", "operationId": "get_file_context_reviews__run_id__files__file_id__content_get", "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Run Id"}}, {"name": "file_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid", "title": "File Id"}}, {"name": "tenant_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid", "title": "Tenant Id"}}, {"name": "start_line", "in": "query", "required": true, "schema": {"type": "integer", "title": "Start Line"}}, {"name": "end_line", "in": "query", "required": true, "schema": {"type": "integer", "title": "End Line"}}, {"name": "side", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/DiffSide", "default": "new"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"