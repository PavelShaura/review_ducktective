  "components": {
    "schemas": {
      "ChangeType": {
        "type": "string",
        "enum": [
          "added",
          "modified",
          "deleted",
          "renamed"
        ],
        "title": "ChangeType"
      },
      "DiffSide": {
        "type": "string",
        "enum": [
          "old",
          "new"
        ],
        "title": "DiffSide",
        "description": "Сторона диффа: находка может относиться к удалённому или к новому коду."
      },
      "EgressPolicy": {
        "type": "string",
        "enum": [
          "local_only",
          "allow_cloud"
        ],
        "title": "EgressPolicy",
        "description": "Разрешено ли отправлять код репозитория внешним провайдерам моделей."
      },
      "FeedbackResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "verdict": {
            "$ref": "#/components/schemas/FeedbackVerdict"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "verdict",
          "comment",
          "created_at"
        ],
        "title": "FeedbackResponse"
      },
      "FeedbackVerdict": {
        "type": "string",
        "enum": [
          "useful",
          "false_positive",
          "wontfix"
        ],
        "title": "FeedbackVerdict",
        "description": "Оценка находки человеком. Источник данных для eval-набора."
      },
      "FileContextResponse": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "side": {
            "$ref": "#/components/schemas/DiffSide"
          },
          "commit_sha": {
            "type": "string",
            "title": "Commit Sha"
          },
          "start_line": {
            "type": "integer",
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "title": "End Line"
          },
          "total_lines": {
            "type": "integer",
            "title": "Total Lines"
          },
          "lines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "path",
          "side",
          "commit_sha",
          "start_line",
          "end_line",
          "total_lines",
          "lines"
        ],
        "title": "FileContextResponse"
      },
      "FilePatchResponse": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "previous_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Path"
          },
          "change_type": {
            "$ref": "#/components/schemas/ChangeType"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "added_lines": {
            "type": "integer",
            "title": "Added Lines"
          },
          "removed_lines": {
            "type": "integer",
            "title": "Removed Lines"
          },
          "is_too_large": {
            "type": "boolean",
            "title": "Is Too Large"
          },
          "patch_size_bytes": {
            "type": "integer",
            "title": "Patch Size Bytes"
          },
          "patch": {
            "type": "string",
            "title": "Patch"
          }
        },
        "type": "object",
        "required": [
          "path",
          "previous_path",
          "change_type",
          "language",
          "added_lines",
          "removed_lines",
          "is_too_large",
          "patch_size_bytes",
          "patch"
        ],
        "title": "FilePatchResponse"
      },
      "FindingCategory": {
        "type": "string",
        "enum": [
          "correctness",
          "security",
          "performance",
          "style",
          "tests",
          "architecture"
        ],
        "title": "FindingCategory"
      },
      "FindingResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "file_path": {
            "type": "string",
            "title": "File Path"
          },
          "line_start": {
            "type": "integer",
            "title": "Line Start"
          },
          "line_end": {
            "type": "integer",
            "title": "Line End"
          },
          "side": {
            "$ref": "#/components/schemas/DiffSide"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "category": {
            "$ref": "#/components/schemas/FindingCategory"
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body_markdown": {
            "type": "string",
            "title": "Body Markdown"
          },
          "suggested_patch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Patch"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "producer_name": {
            "type": "string",
            "title": "Producer Name"
          },
          "latest_verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FeedbackVerdict"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "file_path",
          "line_start",
          "line_end",
          "side",
          "severity",
          "category",
          "status",
          "title",
          "body_markdown",
          "suggested_patch",
          "confidence",
          "producer_name",
          "latest_verdict"
        ],
        "title": "FindingResponse"
      },
      "FindingStatus": {
        "type": "string",
        "enum": [
          "proposed",
          "verified",
          "rejected",
          "published"
        ],
        "title": "FindingStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "redis": {
            "type": "boolean",
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "redis"
        ],
        "title": "HealthResponse"
      },
      "HunkResponse": {
        "properties": {
          "old_start": {
            "type": "integer",
            "title": "Old Start"
          },
          "old_lines": {
            "type": "integer",
            "title": "Old Lines"
          },
          "new_start": {
            "type": "integer",
            "title": "New Start"
          },
          "new_lines": {
            "type": "integer",
            "title": "New Lines"
          },
          "header": {
            "type": "string",
            "title": "Header"
          }
        },
        "type": "object",
        "required": [
          "old_start",
          "old_lines",
          "new_start",
          "new_lines",
          "header"
        ],
        "title": "HunkResponse"
      },
      "RegisterRepositoryRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "title": "Tenant Id"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "vcs_provider": {
            "$ref": "#/components/schemas/VcsProvider",
            "default": "local"
          },
          "local_path": {
            "type": "string",
            "format": "path",
            "title": "Local Path"
          },
          "remote_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remote Url"
          },
          "default_branch": {
            "type": "string",
            "title": "Default Branch",
            "default": "main"
          },
          "egress_policy": {
            "$ref": "#/components/schemas/EgressPolicy",
            "default": "local_only"
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "name",
          "local_path"
        ],
        "title": "RegisterRepositoryRequest"
      },
